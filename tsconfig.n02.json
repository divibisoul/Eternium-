{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "api/soul-mesh/**/*.ts",
    "src/soul-mesh/**/*.ts",
    "services/geminiReliability.ts",
    "services/geminiService.ts",
    "types.ts"
  ]
}
