# N02 Soul Mesh — server-side peer endpoints
# Each value must be the public POST endpoint of the corresponding independent nucleus.
SOUL_MESH_N01_URL=https://<n01-host>/api/soul-mesh
SOUL_MESH_N03_URL=https://<n03-host>/api/soul-mesh
SOUL_MESH_N04_URL=https://<n04-host>/api/soul-mesh
SOUL_MESH_N05_URL=https://<n05-host>/api/soul-mesh
SOUL_MESH_N06_URL=https://<n06-host>/api/soul-mesh

# Shared inbound token for N02, if HMAC is not configured.
SOUL_MESH_TOKEN=

# Canonical N01-compatible Mesh secret. Keep server-side only; >= 16 bytes.
SOUL_MESH_HMAC_SECRET=

# Optional per-peer outbound Bearer tokens for legacy/transition peers.
SOUL_MESH_TOKEN_N01=
SOUL_MESH_TOKEN_N03=
SOUL_MESH_TOKEN_N04=
SOUL_MESH_TOKEN_N05=
SOUL_MESH_TOKEN_N06=

# Development-only escape hatch. Never enable in production.
MESH_AUTH_DISABLED=false

# Optional resilience tuning (defaults are compiled into api/soul-mesh/resilience.ts).
N02_MESH_FAILURE_THRESHOLD=3
N02_MESH_RESET_TIMEOUT_MS=15000
N02_MESH_MAX_RETRIES=2
N02_MESH_BASE_BACKOFF_MS=100
N02_MESH_MAX_BACKOFF_MS=1500

# Existing Gemini runtime credential.
API_KEY=
