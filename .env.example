# N02 Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# N02 local Ollama provider (optional, server/runtime side)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_REQUEST_TIMEOUT_MS=30000

# Soul Mesh
SOUL_MESH_HMAC_SECRET=
SOUL_MESH_N01_URL=
SOUL_MESH_N03_URL=
SOUL_MESH_N04_URL=
SOUL_MESH_N05_URL=
SOUL_MESH_N06_URL=
SOUL_MESH_N07_URL=

# SARA federation
SARA_SERVICE_URL=
SARA_SERVICE_TOKEN=
SARA_REQUEST_TIMEOUT_MS=15000


# Gemini API credentials. API_KEY remains supported for legacy deployments.
GEMINI_API_KEY=
GOOGLE_API_KEY=
